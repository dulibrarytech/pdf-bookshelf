# Application
APP_NAME=PDF Bookshelf @ DU
APP_VERSION=v2.0.0
ORGANIZATION=University of Denver Libraries
APP_HOST=localhost
APP_PORT=8005
APP_PATH=/bookshelf
HOST=http://localhost:8005
NODE_ENV=development

# JWT
# TOKEN_SECRET is required - the app refuses to start without it.
# Generate one with: openssl rand -hex 32
TOKEN_SECRET=<your-secret-token>
TOKEN_ALGO=HS512
TOKEN_EXPIRES=12h
TOKEN_ISSUER=https://<your-domain>

# SSO
SSO_URL=<your-sso-provider-url>
SSO_RESPONSE_URL=http://localhost:8005/bookshelf/sso
SSO_LOGOUT_URL=<your-sso-logout-url>

# The hostname the identity proxy posts the callback from, matched against the
# HTTP_HOST it sends. While SSO_REQUIRE_HMAC is off this is the ONLY thing
# narrowing who may post an identity to /sso, so set it in every deployed
# environment. The app warns at boot if it is missing.
SSO_HOST=<your-sso-provider-hostname>

# Signature + replay verification. Both are implemented and unit-tested, and
# both ship OFF because the DU authproxy does not sign its callbacks yet.
# Turning them on is coordinated with DU IT - do not flip them unilaterally.
# The app warns at boot for whichever layer is inactive.
SSO_HMAC_SECRET=<shared-secret-with-identity-provider>
# optional second secret for zero-downtime rotation
SSO_HMAC_SECRET_NEXT=
SSO_REQUIRE_HMAC=0
SSO_REQUIRE_FRESHNESS=0
SSO_MAX_SKEW_SECONDS=300

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=<your-db-username>
DB_PASSWORD=<your-db-password>
DB_NAME=pdf_bookshelf

# Storage
STORAGE_PATH=./storage
