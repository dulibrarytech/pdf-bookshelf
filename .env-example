# Application
APP_NAME=PDF Bookshelf @ DU
APP_VERSION=v2.0.0
ORGANIZATION=University of Denver Libraries
APP_HOST=localhost
APP_PORT=8005
APP_PATH=/bookshelf
# production on a deployed host: it marks the session cookie Secure, compresses
# responses and caches templates. The app warns at boot if it looks deployed
# (SSO_RESPONSE_URL or APP_HOST naming another machine) with anything else.
NODE_ENV=development

# JWT
# TOKEN_SECRET is required - the app refuses to start without it.
# Generate one with: openssl rand -hex 32
TOKEN_SECRET=<your-secret-token>
TOKEN_ALGO=HS512
# A number with a unit: 12h, 30m, 7d. A bare number would be read as
# MILLISECONDS by the token library, so the app refuses to start on one.
TOKEN_EXPIRES=12h
TOKEN_ISSUER=https://<your-domain>

# SSO
SSO_URL=<your-sso-provider-url>
SSO_RESPONSE_URL=http://localhost:8005/bookshelf/sso
SSO_LOGOUT_URL=<your-sso-logout-url>

# The hostname the identity proxy posts the callback from, matched against the
# HTTP_HOST it sends. While SSO_REQUIRE_HMAC is off this is the ONLY thing
# narrowing who may post an identity to /sso, so set it in every deployed
# environment. The app warns at boot if it is missing.
SSO_HOST=<your-sso-provider-hostname>

# Signature + replay verification. Both are implemented and tested, and both
# ship OFF because the DU authproxy does not sign its callbacks yet. Turning
# them on is coordinated with DU IT - do not flip them unilaterally. The app
# warns at boot for whichever layer is inactive.
SSO_HMAC_SECRET=<shared-secret-with-identity-provider>
# optional second secret for zero-downtime rotation
SSO_HMAC_SECRET_NEXT=
SSO_REQUIRE_HMAC=0
# Freshness (timestamp within SSO_MAX_SKEW_SECONDS, nonce unused) is ALWAYS
# checked when HMAC is on - the signature covers those fields precisely so a
# captured callback cannot be replayed - so set this to 1 alongside it. On its
# own it adds little: an unsigned callback can be minted fresh by anyone.
SSO_REQUIRE_FRESHNESS=0
SSO_MAX_SKEW_SECONDS=300

# Sign-in callbacks accepted per client address per minute. This is abuse
# throttling, not a security control (while HMAC is off one forged callback is
# enough), and it is keyed by IP, which DU users share: campus NAT and the VPN
# put a whole class behind one address, so it has to absorb a room signing in
# at once. Anyone refused sees an error page with a "Try again" link.
SSO_RATE_LIMIT_PER_MINUTE=300

# Proxy
# Which upstream proxies may set X-Forwarded-For (Express "trust proxy").
# req.ip, and with it every per-address rate limit, is only as right as this:
# trust the wrong hop and everyone behind nginx shares one bucket. "loopback"
# is right when nginx runs on this host. If TLS terminates on another machine,
# name it - an IP or CIDR range, comma-separated for several, e.g. 10.0.0.5
TRUST_PROXY=loopback

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=<your-db-username>
DB_PASSWORD=<your-db-password>
DB_NAME=pdf_bookshelf

# Storage
STORAGE_PATH=./storage
