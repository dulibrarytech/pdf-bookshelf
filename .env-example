# Application
APP_NAME=PDF Bookshelf @ DU
APP_VERSION=v2.0.0
ORGANIZATION=University of Denver Libraries
APP_HOST=localhost
APP_PORT=8005
APP_PATH=/bookshelf
HOST=http://localhost:8005
NODE_ENV=development

# JWT (phase 2) - https://randomkeygen.com/
TOKEN_SECRET=<your-secret-token>
TOKEN_ALGO=HS512
TOKEN_EXPIRES=12h
TOKEN_ISSUER=https://<your-domain>

# SSO (HMAC-verified callback; shared DU IT spec - same as repo-backend-v2)
SSO_URL=<your-sso-provider-url>
SSO_RESPONSE_URL=http://localhost:8005/bookshelf/sso
# IdP central signout (logout 302s here so the user signs out everywhere)
SSO_LOGOUT_URL=https://login.du.edu/_layouts/pg/signout.aspx
# legacy HTTP_HOST string match; the operative check while HMAC is off. Set in prod.
SSO_HOST=<your-sso-host>
SSO_HMAC_SECRET=<shared-secret-with-identity-provider>
# optional second secret for zero-downtime rotation
SSO_HMAC_SECRET_NEXT=
# HMAC + freshness are built but OFF by default - the DU identity proxy does not
# sign callbacks yet (same rollout as repo-backend-v2). Set both to 1 the moment
# it does; until then the callback trusts the POSTed employeeID (legacy mode).
SSO_REQUIRE_HMAC=0
SSO_REQUIRE_FRESHNESS=0
SSO_MAX_SKEW_SECONDS=300

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=<your-db-username>
DB_PASSWORD=<your-db-password>
DB_NAME=pdf_bookshelf

# Storage
STORAGE_PATH=./storage
