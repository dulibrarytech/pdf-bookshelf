<%- include('partials/header.ejs') %>

<h1 class="page-title">Upload PDFs</h1>
<p class="page-subtitle">Add purchased PDFs to the bookshelf.</p>

<div class="row">
    <div class="col-lg-8">
        <div class="content-card">
            <div>
                <form id="upload-form"
                      hx-post="<%= app_path %>/dashboard/uploads"
                      hx-encoding="multipart/form-data"
                      hx-target="#upload-results" hx-swap="innerHTML"
                      hx-indicator="#upload-progress">
                    <div class="mb-3">
                        <div class="dropzone" id="dropzone" tabindex="0" role="button"
                             aria-label="Drag and drop PDF files here, or press Enter to browse">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                <polyline points="17 8 12 3 7 8"/>
                                <line x1="12" y1="3" x2="12" y2="15"/>
                            </svg>
                            <div class="dropzone-label">Drag and drop PDF files here</div>
                            <div class="dropzone-sub">or click to browse &middot; up to 10 files, 100 MB each</div>
                        </div>
                        <input class="visually-hidden" type="file" id="pdfs" name="pdfs"
                               accept="application/pdf,.pdf" multiple tabindex="-1">
                    </div>
                    <ul class="list-group mb-3 d-none" id="upload-file-list"></ul>
                    <div class="text-danger small mb-3 d-none" id="upload-file-error" aria-live="polite"></div>
                    <div class="progress mb-3 htmx-indicator" id="upload-progress" style="height: 6px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" id="upload-progress-bar"
                             role="progressbar" style="width: 0%" aria-label="Upload progress"
                             aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
                    </div>
                    <button type="submit" class="btn btn-primary" id="upload-submit" disabled>
                        Begin upload
                    </button>
                </form>
            </div>
        </div>
        <div id="upload-results" class="mt-3" aria-live="polite"></div>
    </div>
</div>

<script src="<%= app_path %>/static/assets/js/upload.js?v=<%= asset_v %>" defer></script>
<%- include('partials/footer.ejs') %>
