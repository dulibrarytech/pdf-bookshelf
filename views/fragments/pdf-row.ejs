<tr id="pdf-<%= row.uuid %>">
    <td class="package-cell">
        <div class="package-name"><%= row.title || row.filename %></div>
        <div class="package-sub"><%= row.filename %>.pdf</div>
    </td>
    <td class="timestamp-cell"><%= format.file_size(row.file_size) %></td>
    <td><%= row.hits %></td>
    <td class="timestamp-cell"><%= format.date(row.created) %></td>
    <td class="actions-cell">
        <div class="dropdown">
            <button type="button" class="kebab-btn"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="Actions for <%= row.title || row.filename %>"
                    title="Actions">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <circle cx="12" cy="5" r="1.75"/>
                    <circle cx="12" cy="12" r="1.75"/>
                    <circle cx="12" cy="19" r="1.75"/>
                </svg>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item"
                       href="<%= app_path %>/viewer?pdf=<%= row.uuid %>"
                       target="_blank" rel="noopener">
                        <%/* eye icon - open in the viewer */%>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                        View<span class="visually-hidden"> (opens in new tab)</span>
                    </a>
                </li>
                <li>
                    <button type="button" class="dropdown-item"
                            data-copy-url="/pdf/<%= encodeURIComponent(row.filename) %>"
                            data-copy-name="<%= row.title || row.filename %>">
                        <%/* copy icon - cataloged URL to clipboard */%>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                        </svg>
                        <span class="copy-label">Copy URL</span>
                    </button>
                </li>
                <li>
                    <button type="button" class="dropdown-item"
                            hx-get="<%= app_path %>/dashboard/pdfs/<%= row.uuid %>/edit"
                            hx-target="closest tr" hx-swap="outerHTML">
                        <%/* pencil icon - edit title */%>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/>
                        </svg>
                        Edit title
                    </button>
                </li>
                <% if (user && user.role === 'admin') { %>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <button type="button" class="dropdown-item text-danger"
                            hx-delete="<%= app_path %>/dashboard/pdfs/<%= row.uuid %>"
                            hx-confirm="Remove &quot;<%= row.title || row.filename %>&quot; from the bookshelf? The file stays in storage."
                            hx-target="closest tr" hx-swap="outerHTML">
                        <%/* trash icon - soft delete */%>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                            <line x1="10" y1="11" x2="10" y2="17"/>
                            <line x1="14" y1="11" x2="14" y2="17"/>
                        </svg>
                        Remove
                    </button>
                </li>
                <% } %>
            </ul>
        </div>
    </td>
</tr>
