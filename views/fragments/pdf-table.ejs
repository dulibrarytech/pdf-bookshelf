<%
/* the search term and the "Show removed" toggle ride every sort and page
   link, so neither is lost when the table is re-fetched */
const filters = `q=${encodeURIComponent(table.q)}${table.removed ? '&removed=1' : ''}`;

/* sortable column header: toggles direction when already sorted by that column.
   Emits the whole <th> so the active column carries aria-sort (WCAG 1.3.1);
   the arrow glyph is decorative - aria-hidden. */
function sort_th(key, label) {
    const is_active = table.sort === key;
    const dir = (is_active && table.dir === 'asc') ? 'desc' : 'asc';
    const aria_sort = is_active ? ` aria-sort="${table.dir === 'asc' ? 'ascending' : 'descending'}"` : '';
    const arrow = is_active ? `<span aria-hidden="true">${table.dir === 'asc' ? ' &#9650;' : ' &#9660;'}</span>` : '';
    const url = `${app_path}/dashboard/pdfs?${filters}&sort=${key}&dir=${dir}&page=1`;
    return `<th scope="col"${aria_sort}><a href="#" hx-get="${url}" hx-target="#bookshelf-table" hx-swap="innerHTML">${label}${arrow}</a></th>`;
}

function page_link(page) {
    return `${app_path}/dashboard/pdfs?${filters}&sort=${table.sort}&dir=${table.dir}&page=${page}`;
}
%>
<%/* no overflow wrapper: it would clip the kebab dropdowns */%>
<div>
    <table class="queue-table mb-3">
        <thead>
        <tr>
            <%- sort_th('title', 'Title') %>
            <%- sort_th('file_size', 'Size') %>
            <%- sort_th('hits', 'Requests') %>
            <%- sort_th('created', 'Added') %>
            <th scope="col" class="actions-cell">Actions</th>
        </tr>
        </thead>
        <tbody id="bookshelf-rows">
        <% if (table.rows.length === 0) { %>
        <tr>
            <td colspan="5" class="text-center text-body-secondary py-4">
                <% if (table.q.length > 0) { %>No PDFs match &ldquo;<%= table.q %>&rdquo;.<% } else { %>The bookshelf is empty.<% } %>
            </td>
        </tr>
        <% } %>
        <% for (const row of table.rows) { %>
            <%- include('pdf-row', {row: row}) %>
        <% } %>
        </tbody>
    </table>
</div>

<div class="d-flex align-items-center justify-content-between">
    <span class="text-body-secondary small" id="bookshelf-count">
        <%= table.total %> PDF<%= table.total === 1 ? '' : 's' %><% if (table.removed) { %> including removed<% } %><% if (table.q.length > 0) { %> matching &ldquo;<%= table.q %>&rdquo;<% } %><% if (table.page_count > 1) { %>, page <%= table.page %> of <%= table.page_count %><% } %>
    </span>
    <% if (table.page_count > 1) { %>
    <nav aria-label="Bookshelf pages">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item <%= table.page === 1 ? 'disabled' : '' %>">
                <% if (table.page === 1) { %>
                <span class="page-link" aria-hidden="true">&laquo;</span>
                <% } else { %>
                <a class="page-link" href="#" aria-label="Previous page" hx-get="<%= page_link(table.page - 1) %>" hx-target="#bookshelf-table" hx-swap="innerHTML"><span aria-hidden="true">&laquo;</span></a>
                <% } %>
            </li>
            <li class="page-item disabled"><span class="page-link">Page <%= table.page %> of <%= table.page_count %></span></li>
            <li class="page-item <%= table.page === table.page_count ? 'disabled' : '' %>">
                <% if (table.page === table.page_count) { %>
                <span class="page-link" aria-hidden="true">&raquo;</span>
                <% } else { %>
                <a class="page-link" href="#" aria-label="Next page" hx-get="<%= page_link(table.page + 1) %>" hx-target="#bookshelf-table" hx-swap="innerHTML"><span aria-hidden="true">&raquo;</span></a>
                <% } %>
            </li>
        </ul>
    </nav>
    <% } %>
</div>
