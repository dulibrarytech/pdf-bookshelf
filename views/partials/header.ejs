<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=yes">
    <title><%= typeof title !== 'undefined' && title ? title + ' - ' : '' %><%= appname %></title>
    <link rel="icon" type="image/svg+xml" href="<%= app_path %>/static/images/du-main-tab-logo.svg">
    <link rel="stylesheet" href="<%= app_path %>/static/libs/bootstrap/bootstrap.min.css?v=<%= asset_v %>">
    <link rel="stylesheet" href="<%= app_path %>/static/assets/styles.css?v=<%= asset_v %>">
    <script src="<%= app_path %>/static/libs/htmx/htmx.min.js?v=<%= asset_v %>" defer></script>
    <script src="<%= app_path %>/static/libs/bootstrap/bootstrap.bundle.min.js?v=<%= asset_v %>" defer></script>
    <script src="<%= app_path %>/static/assets/js/app.js?v=<%= asset_v %>" defer></script>
</head>
<body>
<a href="#main-content" class="skip-link">Skip to main content</a>
<div class="app-shell">
    <header class="app-header">
        <a href="<%= app_path %>/dashboard/home"
           class="brand-block"
           aria-label="University Libraries — University of Denver — Home">
            <img class="du-logo"
                 src="<%= app_path %>/static/images/du-logo.png"
                 alt="University Libraries — University of Denver">
        </a>

        <div class="app-title">
            PDF Bookshelf <span class="accent">@ DU</span>
        </div>

        <div class="header-spacer"></div>

        <div class="header-actions">
            <% if (typeof user !== 'undefined' && user) { %>
                <span class="user-label">
                    <%= user.first_name || user.du_id %><%= user.last_name ? ' ' + user.last_name : '' %>
                </span>
                <%/* a form, not a link: signing out changes state, and a GET
                     could be triggered by a link on anyone's page */%>
                <form method="post" action="<%= app_path %>/logout" class="sign-out">
                    <button type="submit" title="Sign out" aria-label="Sign out">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.75"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                            <polyline points="16 17 21 12 16 7"/>
                            <line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>
                    </button>
                </form>
            <% } %>
        </div>
    </header>

    <%
        /* sidebar highlighting: pages pass `active` via view locals */
        const nav_active = typeof active !== 'undefined' ? active : '';
        const is_admin = typeof user !== 'undefined' && user && user.role === 'admin';
    %>
    <nav class="app-sidebar" aria-label="Main navigation">
        <a href="<%= app_path %>/dashboard/home"
           class="<%= nav_active === 'home' ? 'active' : '' %>"
           <% if (nav_active === 'home') { %>aria-current="page"<% } %>
           aria-label="Bookshelf" title="Bookshelf">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 9.5L12 3l9 6.5"/>
                <path d="M5 9v11a1 1 0 0 0 1 1h4v-7h4v7h4a1 1 0 0 0 1-1V9"/>
            </svg>
        </a>

        <a href="<%= app_path %>/dashboard/upload"
           class="<%= nav_active === 'upload' ? 'active' : '' %>"
           <% if (nav_active === 'upload') { %>aria-current="page"<% } %>
           aria-label="Upload" title="Upload">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
        </a>

        <% if (is_admin) { %>
        <a href="<%= app_path %>/dashboard/users"
           class="<%= nav_active === 'users' ? 'active' : '' %>"
           <% if (nav_active === 'users') { %>aria-current="page"<% } %>
           aria-label="Users" title="Users">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
        </a>

        <a href="<%= app_path %>/dashboard/utils"
           class="<%= nav_active === 'utils' ? 'active' : '' %>"
           <% if (nav_active === 'utils') { %>aria-current="page"<% } %>
           aria-label="Utilities" title="Utilities">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="3"/>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
        </a>
        <% } %>
    </nav>

    <main id="main-content" class="app-main" tabindex="-1">
