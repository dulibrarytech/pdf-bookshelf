<!doctype html>
<html lang="en">
<%/* Reached by a typed or bookmarked GET /logout, or by a sign-out form on
     some other site: neither changes anything. The button posts from this
     origin, which is the one request that does. */%>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign out - <%= appname %></title>
    <link rel="icon" type="image/svg+xml" href="<%= app_path %>/static/images/du-main-tab-logo.svg">
    <link rel="stylesheet" href="<%= app_path %>/static/libs/bootstrap/bootstrap.min.css">
    <link rel="stylesheet" href="<%= app_path %>/static/assets/styles.css">
</head>
<body>
<main class="message-shell">
    <div class="message-card">
        <img class="du-logo" src="<%= app_path %>/static/images/du-logo.png"
             alt="University Libraries — University of Denver">
        <h1 class="h5 mb-3">PDF Bookshelf <span style="color: var(--du-crimson);">@ DU</span></h1>
        <p class="text-body-secondary">Sign out of PDF Bookshelf?</p>
        <form method="post" action="<%= app_path %>/logout" class="m-0">
            <button type="submit" class="btn btn-primary btn-sm">Sign out</button>
            <a class="btn btn-link btn-sm" href="<%= app_path %>/dashboard/home">Back to the bookshelf</a>
        </form>
    </div>
</main>
</body>
</html>
